{
  "id": "dev.pepino.hello-world",
  "name": "Hello world",
  "version": "1.0.0",
  "apiVersion": "1",
  "description": "The smallest plugin: one command that says hello, and a page of its own.",
  "permissions": [],
  "contributes": {
    "commands": [{ "id": "hello", "title": "Say hello" }],
    "pages": [{ "id": "hello", "title": "Hello", "file": "hello.html" }],
    "settings": [{ "key": "name", "type": "string", "default": "Pepino", "title": "Who to greet" }]
  }
}
